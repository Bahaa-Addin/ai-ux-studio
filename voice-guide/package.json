{
  "name": "voice-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Voice guide platform: one SDK script tag on any page, stateless services behind a gateway, ingestion jobs that build the site knowledge base.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#text": "./packages/text/src/index.ts",
    "#kb": "./packages/kb/src/index.ts",
    "#shared/*": "./services/shared/*",
    "#services/*": "./services/*",
    "#jobs/*": "./jobs/*"
  },
  "scripts": {
    "dev": "node tools/dev.ts",
    "fixtures": "node tools/serve-site.ts --site demo-telco",
    "build:sdk": "node packages/sdk/build.ts",
    "ingest": "node jobs/ingest.ts",
    "sync": "node jobs/sync.ts",
    "kb": "node tools/kb/cli.ts",
    "db:migrate": "node services/shared/migrate.ts",
    "eval:router": "node tools/eval-router.ts",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-force-exit --test-concurrency=1 --test-timeout=120000 \"tests/e2e/**/*.test.ts\"",
    "typecheck": "node tools/typecheck.ts",
    "snapshot:manifest": "node tools/fixtures/snapshot-manifest.ts",
    "record:demo": "node tools/record-demo.ts",
    "gateway": "node services/gateway/main.ts",
    "service": "node services/run-service.ts",
    "docs:diagrams": "node tools/docs/render-diagrams.ts",
    "demo:live": "node tools/demo-live.ts",
    "demo:trail": "node tools/demo-live.ts --replay --trail --start https://web.vodafone.com.eg/en/home",
    "measure:trail": "node tools/trail-measure.ts",
    "live-crawl:import": "node tools/live-crawl/import.ts",
    "live-crawl:bundle": "node tools/live-crawl/bundle.ts",
    "experience": "node jobs/experience.ts",
    "speech:warm": "node tools/speech-warm.ts",
    "extension:build": "node tools/extension/build.ts",
    "deploy:cloudrun": "node tools/deploy-cloudrun.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "pg": "8.23.1",
    "playwright": "1.56.0",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@page-agent/core": "1.12.4",
    "@page-agent/llms": "1.12.4",
    "@page-agent/page-controller": "1.12.4",
    "@rrweb/record": "2.2.0",
    "@rrweb/replay": "2.2.0",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "rrweb": "2.2.0",
    "rrweb-snapshot": "2.2.0",
    "rrdom": "2.2.0",
    "@rrweb/types": "2.2.0",
    "@rrweb/utils": "2.2.0"
  }
}
