{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "paths": {
      "#kb": [
        "./../kb/src/browser.ts"
      ]
    },
    "typeRoots": []
  },
  "include": [
    "src/**/*.ts",
    "types.d.ts"
  ]
}
